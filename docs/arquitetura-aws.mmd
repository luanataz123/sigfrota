%% Arquitetura AWS - SIG Frota (modulo Lavagem) - versao alinhada ao codigo
%% Implementado hoje: front React (web/), infra CDK (DynamoDB, Cognito,
%%   API Gateway HTTP API + JWT, Lambda, S3+CloudFront, SSM, cdk-nag).
%% Planejado (specs 5/6, ainda nao no CDK): Bedrock, Step Functions, EventBridge.
graph TB
    user["Gestor / Atendente<br/>(navegador)"]

    subgraph front["Front-end (web/ - React + Vite + Tailwind)"]
        spa["SPA React<br/>LoginPage + RequireAuth<br/>painel de lavagens + form"]
        clients["clientFactory<br/>MockLavagemClient (VITE_USE_MOCK=true)<br/>HttpLavagemClient (JWT Bearer, trata 401)"]
    end

    subgraph edge["Borda / Entrega (infra/constructs/front.ts)"]
        cf["Amazon CloudFront<br/>HTTPS, OAC, CSP/HSTS<br/>SPA fallback index.html"]
        s3web["Amazon S3 (privado)<br/>build do front + config.json<br/>BlockPublicAccess, SSE-S3"]
    end

    subgraph auth["Autenticacao (infra/constructs/autenticacao.ts)"]
        cognito["Amazon Cognito User Pool<br/>self-signup desabilitado<br/>grupos atendente/gestor"]
    end

    subgraph api["API (infra/constructs/api.ts)"]
        apigw["API Gateway HTTP API (v2)<br/>HttpJwtAuthorizer (padrao)<br/>GET /veiculos, /veiculos/:id/lavagens,<br/>/lavagens/:id, /tipos-lavagem, /postos<br/>POST/PUT/DELETE /lavagens"]
    end

    subgraph compute["Computacao (infra/constructs/funcao-lambda.ts)"]
        lmbLav["AWS Lambda (NodejsFunction)<br/>api-lavagens: regras R01-R23<br/>usa packages/dominio"]
    end

    subgraph dados["Dados (infra/constructs/dados.ts)"]
        ddb["Amazon DynamoDB<br/>tabela unica PK/SK<br/>KMS, PITR"]
    end

    subgraph obs["Config / Observabilidade (base-stack.ts)"]
        ssm["AWS SSM Parameter Store<br/>/sigfrota/... (contrato de infra)<br/>+ CfnOutput"]
        cw["Amazon CloudWatch Logs"]
    end

    subgraph ia["IA - PLANEJADO (specs 5/6, ainda nao no CDK)"]
        bedrock["Amazon Bedrock<br/>extracao de regras / leitura de recibo"]
        sfn["AWS Step Functions<br/>orquestracao"]
        s3up["Amazon S3<br/>upload de recibo/SQL"]
    end

    iac["AWS CDK + cdk-nag<br/>us-east-1, menor privilegio"]

    user -->|HTTPS| cf
    cf -->|OAC| s3web
    cf --> spa
    spa --> clients
    user -->|login OIDC| cognito
    clients -->|REST + JWT| apigw
    apigw -->|valida token| cognito
    apigw --> lmbLav
    lmbLav -->|Query/GetItem/PutItem| ddb
    lmbLav --> cw
    apigw --> cw
    iac -.provisiona.-> edge
    iac -.provisiona.-> auth
    iac -.provisiona.-> api
    iac -.provisiona.-> compute
    iac -.provisiona.-> dados
    iac -.publica.-> ssm

    sfn -.-> bedrock
    sfn -.-> s3up
    apigw -. futuro .-> sfn

    classDef planned fill:#f5f5f5,stroke:#999,stroke-dasharray:5 5,color:#555;
    class ia,bedrock,sfn,s3up planned;
