{
  "name": "infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infraestrutura como código (AWS CDK) do SIG Frota — módulo de Lavagem",
  "scripts": {
    "bootstrap": "cdk bootstrap --profile hackaton",
    "synth": "cdk synth --all --profile hackaton",
    "deploy": "cdk deploy --all --require-approval never --profile hackaton",
    "destroy": "cdk destroy --all --force --profile hackaton",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "usuarios": "node scripts/criar-usuarios.mjs",
    "env-web": "node scripts/gerar-env-web.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "cdk-nag": "3.0.2",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "3.1147.0",
    "@aws-sdk/client-cognito-identity-provider": "3.1147.0",
    "@types/node": "26.6.4",
    "aws-cdk": "2.1144.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
