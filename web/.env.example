# Alterna entre o client HTTP real e o MockLavagemClient (Req. 11.2).
#  - true  : usa MockLavagemClient (demo/dev sem AWS; default seguro).
#  - false : usa HttpLavagemClient contra VITE_API_BASE_URL (Req. 11.1).
VITE_USE_MOCK=true

# Base URL da API api-lavagens, usada apenas quando VITE_USE_MOCK=false.
# Sem barra final (ex.: https://abc123.execute-api.us-east-1.amazonaws.com).
# Se VITE_USE_MOCK=false e esta variável estiver vazia, o clientFactory falha
# cedo com erro de configuração.
VITE_API_BASE_URL=
