# Modelo de configuração do front. Com a infra implantada, NÃO copie este
# arquivo: gere o web/.env.local com `npm run env-web -w infra` (outputs da
# stack SigfrotaBase). O .env.local não é versionado.

# Alterna entre mocks e AWS (Req. 11.2):
#  - true  : MockLavagemClient + MockAuthAdapter (demo/dev sem AWS; default seguro).
#  - false : HttpLavagemClient contra VITE_API_URL + login Cognito (SRP).
VITE_USE_MOCK=true

# Base URL da HTTP API, sem barra final (ex.: https://abc123.execute-api.us-east-1.amazonaws.com).
# Com VITE_USE_MOCK=false e esta variável vazia, o front falha cedo com erro de configuração.
VITE_API_URL=

# Cognito (obrigatórios com VITE_USE_MOCK=false).
VITE_REGIAO=us-east-1
VITE_USER_POOL_ID=
VITE_USER_POOL_CLIENT_ID=
